{
  "name": "shinian",
  "version": "0.1.0",
  "description": "拾念 SHINIAN v0.1 手动闭环 + AI 帮我试一步 + 参考旧经验 + 动态展示栏",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "serve": "tsx src/server/index.ts",
    "start": "npm run build && npm run serve",
    "test:api": "python scripts/test_api.py",
    "test:search": "python scripts/test_search.py",
    "test:consistency": "python scripts/test_consistency.py",
    "test:ai": "python scripts/test_ai.py",
    "test:experience": "python scripts/test_experience.py",
    "test:activity": "python scripts/test_activity.py",
    "test:review": "python scripts/test_review.py",
    "test:links": "python scripts/test_links.py",
    "test:ask": "python scripts/test_ask.py",
    "test:topics": "python scripts/test_topics.py",
    "test:e2e:topics": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_e2e_topics.ps1",
    "test:all": "python scripts/run_tests.py",
    "test:manual": "python scripts/run_manual_tests.py",
    "test:e2e": "node scripts/e2e_browser.mjs",
    "test:e2e:ai": "node scripts/e2e_ai.mjs",
    "test:e2e:review": "node scripts/e2e_review.mjs",
    "test:e2e:ask": "node scripts/e2e_ask_acceptance.mjs",
    "test:e2e:graph": "node scripts/e2e_graph.mjs",
    "test:export": "python scripts/test_export.py",
    "test:export:topic": "python scripts/test_topic_export.py",
    "test:e2e:topic": "node scripts/e2e_topic_export.mjs",
    "test:backup": "python scripts/test_backup_restore.py",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "verify": "python scripts/verify_main.py",
    "check:v2": "node scripts/check_v2_shell.mjs",
    "seed": "python scripts/seed_acceptance.py",
    "audit:flow": "node scripts/audit_flow.mjs",
    "audit:flow2": "node scripts/audit_flow2.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.90",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@types/better-sqlite3": "^9.6.0",
    "ai": "7.0.170",
    "better-sqlite3": "^13.1.1",
    "drizzle-orm": "^0.38.4",
