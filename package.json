    "react-router-dom": "^7.18.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^1.3.2",
    "drizzle-kit": "^0.30.5",
    "drizzle-zod": "^0.8.3",
    "puppeteer-core": "^25.17.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "zod": "^4.6.7"
  }
